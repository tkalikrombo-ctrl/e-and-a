{
  "name": "e-and-a-mis-english",
  "private": true,
  "version": "1.3.0",
  "description": "Arabic-to-English learning through management information systems",
  "author": "E&A",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkalikrombo-ctrl/e-and-a.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:win": "npm run build && electron-builder --win portable --x64",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.eanda.misenglish.desktop",
    "productName": "E&A",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EA-Windows.exe"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
